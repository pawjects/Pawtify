{
  "name": "pawtify",
  "version": "1.0.0",
  "description": "A privacy-friendly, browser-based static music player featuring local playlist controls and distraction-free streaming.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/build.js",
    "lint": "node --check server.js && node --check api/search.js && node --check app/app.js",
    "format": "prettier --write \"**/*.{html,css,js}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawjects/Pawtify.git"
  },
  "keywords": [
    "music-player",
    "audio-streaming",
    "privacy-first",
    "material-design-3",
    "amoled-dark",
    "pawdevs"
  ],
  "author": "Sky <PawDevs>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pawjects/Pawtify/issues"
  },
  "homepage": "https://github.com/pawjects/Pawtify#readme",
  "devDependencies": {
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ytmusic-api": "^5.3.1"
  }
}
