<resources>
    <style name="Theme.Pawtify" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="colorPrimary">@color/cyan_accent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSecondary">@color/cyan_accent</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Pawtify.MaterialAlertDialog</item>
    </style>

    <style name="ThemeOverlay.Pawtify.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorPrimary">@color/cyan_accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Pawtify.Button.TextButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Pawtify.Button.TextButton.Muted</item>
    </style>

    <style name="Widget.Pawtify.Button.TextButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/cyan_accent</item>
    </style>

    <style name="Widget.Pawtify.Button.TextButton.Muted" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/muted_gray</item>
    </style>
</resources>
