<resources>
    <style name="Theme.Pawtify" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="colorPrimary">@color/cyan_accent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSecondary">@color/cyan_accent</item>
    </style>

    <!-- Native Splash Screen Theme using AndroidX Core Splashscreen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set splash screen AMOLED dark background (#121212) -->
        <item name="windowSplashScreenBackground">@color/surface_dark</item>
        <!-- Set the splash screen logo icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/pawtify_logo</item>
        <!-- Set the theme of the Activity that immediately follows the splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.Pawtify</item>
    </style>
</resources>
