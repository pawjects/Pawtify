{
  "version": 2,
  "builds": [
    { "src": "server/index.js", "use": "@vercel/node" },
    { "src": "client/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server/index.js" },
    { "src": "/sw.js", "dest": "/client/sw.js", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } },
    { "src": "/(.*)", "dest": "/client/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/client/index.html", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
